.vscode/
.idea/
# Pytest cache
.pytest_cache/
# Scratch test files created during development (root level only, not tests/ dir)
/test_*.py
/*_test.py
DEPENDENCY_MANAGEMENT_SUMMARY.md
OPTIONAL_IMPORTS_SUMMARY.md
# Cursor workspace files
*.code-workspace
# Jupyter Notebook
.ipynb_checkpoints
*/.ipynb_checkpoints/*
.idea

# Large data/cache files
data/AICurationCacheCompoundCuration.json
data/ms_classifier/

# claude-skills runtime artifacts (populated by `claude-skills sync`)
.claude/commands/*
.claude/skills/

# Tier-1 dashboard is authored here per kbu-start-v1 PRD (not synced from
# ClaudeCommands); track it explicitly despite the parent ignore rule.
!.claude/commands/kbu-start.md

# Template tree — override ignore patterns so template data is tracked
!templates/research-project/.vscode/
!templates/research-project/.vscode/**
!templates/research-project/**/*.code-workspace

# Research scratch directory (gitignored, local only)
.research/

# opencode session continuation files
.omo/

# Python build artifacts (setuptools/wheel build tree)
build/

# KEGG-derived generated artifacts (kbdl-local-bakta-kofamscan-v1 D6.1/D6.2).
# Produced on the compute host by build_ko_function_map.py and
# build_guard_kofam_profiles.py from bulk KEGG ko/ko_list content; KEGG's
# redistribution terms for that content are more restrictive than this
# repo's own licence, so these must never be committed regardless of where
# they happen to land during local development.
ko_function_map*.tsv
/kofam-guard/
/guard/
/guard.txt

# OntologyDictionary staged dictionaries (kbdl-ontology-descriptions-v1).
# Produced on the compute host by build_ko_description_map.py,
# build_ec_description_map.py, build_go_description_map.py and
# build_cog_description_map.py from bulk third-party ontology releases
# (KEGG ko, ExPASy enzyme.dat, Gene Ontology go-basic.obo, NCBI
# cog-20.def.tab). Each source's redistribution terms are more
# restrictive than this repo's own licence, so these staged dictionaries
# must never be committed regardless of where they happen to land during
# local development -- see the docstring at the top of each generator
# script for the specific licensing reason.
ko_description_map*.tsv
ec_description_map*.tsv
go_description_map*.tsv
cog_description_map*.tsv
